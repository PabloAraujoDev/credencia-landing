# URL pública do site (sem barra final). Ativa canonical, og:url, og:image absoluta, sitemap e robots com sitemap.
SITE_URL=

# Número que recebe os pedidos pelo WhatsApp: DDI + DDD + número, só dígitos (ex.: 5511999999999).
# Usado quando VITE_LEAD_ENDPOINT está vazio.
VITE_WHATSAPP_NUMBER=

# Caminho base da publicação (GitHub Pages de projeto: /<repositório>/). Localmente: vazio.
BASE_PATH=

# Endpoint que recebe o formulário via POST JSON (ex.: Formspree, Web3Forms, função serverless própria).
VITE_LEAD_ENDPOINT=

# E-mail exibido como alternativa quando o envio falha (opcional).
VITE_CONTACT_EMAIL=

# Domínio configurado no Plausible para medição sem cookies (opcional).
VITE_PLAUSIBLE_DOMAIN=
